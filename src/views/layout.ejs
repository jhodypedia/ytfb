<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title><%= typeof title!=="undefined" ? title+" | " : "" %>Live App</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="Dashboard live streaming RTMP YouTube & Facebook dengan jadwal dan keamanan.">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/public/style.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <div class="sidebar bg-dark text-white p-3 min-vh-100">
      <%- include("partials/sidebar") %>
    </div>
    <div class="flex-grow-1">
      <%- include("partials/topbar",{ user }) %>
      <main class="p-4">
        <%- body %>
      </main>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/public/main.js"></script>
</body>
</html>

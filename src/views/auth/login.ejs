<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>Login | Live Streaming App</title>
  <meta name="description" content="Login ke sistem live streaming YouTube & Facebook via RTMP dengan aman.">
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Bootstrap & FontAwesome -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link href="/public/auth.css" rel="stylesheet">
</head>
<body class="auth-body d-flex align-items-center justify-content-center">

  <div class="auth-card shadow-lg p-4 rounded-4 animate__animated animate__fadeIn">
    <div class="text-center mb-4">
      <i class="fa-solid fa-right-to-bracket fa-2x text-primary"></i>
      <h3 class="mt-2">Login</h3>
    </div>

    <!-- ✅ Form tanpa action (AJAX only) -->
    <form id="loginForm" autocomplete="off">
      <div class="mb-3">
        <label class="form-label"><i class="fa fa-user me-2"></i> Username</label>
        <input type="text" class="form-control" name="username" required autocomplete="off">
      </div>
      <div class="mb-3">
        <label class="form-label"><i class="fa fa-lock me-2"></i> Password</label>
        <input type="password" class="form-control" name="password" required autocomplete="new-password">
      </div>
      <div id="captchaContainer" class="my-3 text-center"></div>
      <button type="submit" class="btn btn-primary w-100 mt-2">
        <i class="fa fa-sign-in-alt me-2"></i> Masuk
      </button>
    </form>

    <div class="mt-3 text-center">
      <span>Belum punya akun? <a href="/register">Register</a></span>
    </div>
  </div>

  <!-- JS -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <script src="/public/main.js"></script>

  <script>
  $(function(){
    // ✅ Ambil setting public (tanpa auth)
    $.get("/api/admin/settings/public", (res)=>{
      if(res.ok && res.settings.enable_captcha && res.settings.captcha_keys?.recaptcha?.site){
        const site = res.settings.captcha_keys.recaptcha.site;
        $("#captchaContainer").html(`<div class="g-recaptcha" data-sitekey="${site}"></div>`);
      } else {
        console.warn("Captcha tidak aktif / tidak ada sitekey");
      }
    }).fail(()=>{
      console.error("Gagal load settings");
    });

    // ✅ AJAX login
    $("#loginForm").on("submit", async function(e){
      e.preventDefault();
      const body = {
        username: this.username.value,
        password: this.password.value,
        captchaToken: (typeof grecaptcha !== "undefined" && grecaptcha.getResponse) 
                        ? grecaptcha.getResponse() : null
      };
      try {
        const res = await apiPOST("/api/auth/login", body);
        if(res.ok){
          localStorage.setItem("token", res.token);
          TOKEN = res.token;
          Swal.fire("Berhasil", "Login sukses", "success")
            .then(()=> location.href="/dashboard");
        } else {
          Swal.fire("Gagal", res.message || "Login gagal", "error");
        }
      } catch(err){
        Swal.fire("Error", "Terjadi kesalahan server", "error");
      }
    });
  });
  </script>
</body>
</html>

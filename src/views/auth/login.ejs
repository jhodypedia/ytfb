<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>Login | Live Streaming App</title>
  <meta name="description" content="Login ke sistem live streaming RTMP untuk YouTube dan Facebook.">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/public/auth.css" rel="stylesheet">
</head>
<body class="auth-body d-flex align-items-center justify-content-center">
  <div class="auth-card shadow-lg p-4 rounded-4">
    <div class="text-center mb-4">
      <i class="fa-solid fa-right-to-bracket fa-2x text-primary"></i>
      <h3 class="mt-2">Login</h3>
    </div>
    <form id="loginForm">
      <div class="mb-3"><label class="form-label"><i class="fa fa-user me-2"></i> Username</label><input class="form-control" name="username" required></div>
      <div class="mb-3"><label class="form-label"><i class="fa fa-lock me-2"></i> Password</label><input type="password" class="form-control" name="password" required></div>
      <button class="btn btn-primary w-100 mt-2"><i class="fa fa-sign-in-alt me-2"></i> Masuk</button>
    </form>
    <div class="mt-3 text-center"><span>Belum punya akun? <a href="/register">Register</a></span></div>
  </div>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/public/main.js"></script>
  <script>
  $("#loginForm").on("submit", async function(e){
    e.preventDefault();
    const res = await apiPOST("/api/auth/login",{ username:this.username.value, password:this.password.value });
    if(res.ok){ localStorage.setItem("token",res.token); Swal.fire("Berhasil","Login sukses","success").then(()=>location.href="/dashboard"); }
    else Swal.fire("Gagal",res.message||"Login gagal","error");
  });
  </script>
</body>
</html>

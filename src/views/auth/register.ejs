<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>Register | Live Streaming App</title>
  <meta name="description" content="Daftar akun baru untuk live streaming ke YouTube dan Facebook via RTMP.">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/public/auth.css" rel="stylesheet">
</head>
<body class="auth-body d-flex align-items-center justify-content-center">
  <div class="auth-card shadow-lg p-4 rounded-4">
    <div class="text-center mb-4">
      <i class="fa-solid fa-user-plus fa-2x text-success"></i>
      <h3 class="mt-2">Register</h3>
    </div>
    <form id="registerForm">
      <div class="mb-3"><label class="form-label"><i class="fa fa-user me-2"></i> Username</label><input class="form-control" name="username" required></div>
      <div class="mb-3"><label class="form-label"><i class="fa fa-lock me-2"></i> Password</label><input type="password" class="form-control" name="password" required></div>
      <button class="btn btn-success w-100 mt-2"><i class="fa fa-user-plus me-2"></i> Daftar</button>
    </form>
    <div class="mt-3 text-center"><span>Sudah punya akun? <a href="/login">Login</a></span></div>
  </div>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/public/main.js"></script>
  <script>
  $("#registerForm").on("submit", async function(e){
    e.preventDefault();
    const res = await apiPOST("/api/auth/register",{ username:this.username.value, password:this.password.value });
    if(res.ok){ Swal.fire("Berhasil","Akun dibuat","success").then(()=>location.href="/login"); }
    else Swal.fire("Gagal",res.message||"Registrasi gagal","error");
  });
  </script>
</body>
</html>

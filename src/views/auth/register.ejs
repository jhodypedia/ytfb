<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <title>Register | Live Streaming App</title>
  <meta name="description" content="Daftar akun baru untuk live streaming ke YouTube dan Facebook dengan aman.">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/public/auth.css" rel="stylesheet">
</head>
<body class="auth-body d-flex align-items-center justify-content-center">

  <div class="auth-card shadow-lg p-4 rounded-4 animate__animated animate__fadeIn">
    <div class="text-center mb-4">
      <i class="fa-solid fa-user-plus fa-2x text-success"></i>
      <h3 class="mt-2">Register</h3>
    </div>
    <!-- ✅ tanpa action, AJAX only -->
    <form id="registerForm" autocomplete="off">
      <div class="mb-3">
        <label class="form-label"><i class="fa fa-user me-2"></i> Username</label>
        <input type="text" class="form-control" name="username" required autocomplete="off">
      </div>
      <div class="mb-3">
        <label class="form-label"><i class="fa fa-lock me-2"></i> Password</label>
        <input type="password" class="form-control" name="password" required autocomplete="new-password">
      </div>
      <div id="captchaContainer" class="my-3 text-center"></div>
      <button type="submit" class="btn btn-success w-100 mt-2">
        <i class="fa fa-user-plus me-2"></i> Daftar
      </button>
    </form>
    <div class="mt-3 text-center">
      <span>Sudah punya akun? <a href="/login">Login</a></span>
    </div>
  </div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script src="/public/main.js"></script>
<script>
$(function(){
  $.get("/api/admin/settings", (res)=>{
    if(res.settings.enable_captcha && res.settings.captcha_keys?.recaptcha?.site){
      const site = res.settings.captcha_keys.recaptcha.site;
      $("#captchaContainer").html(`<div class="g-recaptcha" data-sitekey="${site}"></div>`);
    }
  });

  // AJAX register
  $("#registerForm").on("submit", async function(e){
    e.preventDefault();
    const body = {
      username: this.username.value,
      password: this.password.value,
      captchaToken: (typeof grecaptcha !== "undefined" && grecaptcha.getResponse) ? grecaptcha.getResponse() : null
    };
    try {
      const res = await apiPOST("/api/auth/register", body);
      if(res.ok){
        Swal.fire("Berhasil", "Akun berhasil dibuat", "success")
          .then(()=> location.href="/login");
      } else {
        Swal.fire("Gagal", res.message || "Registrasi gagal", "error");
      }
    } catch(err){
      Swal.fire("Error", "Terjadi kesalahan server", "error");
    }
  });
});
</script>
</body>
</html>

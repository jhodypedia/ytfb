<h3>📜 Riwayat Live Facebook</h3>
<table class="table table-bordered table-hover align-middle mt-3">
  <thead class="table-light"><tr><th>ID</th><th>Input</th><th>Status</th><th>Waktu</th><th>Aksi</th></tr></thead>
  <tbody id="fbBody"><tr><td colspan="5" class="text-center text-muted">Memuat...</td></tr></tbody>
</table>
<script>
(async function(){
  const res = await apiGET("/api/facebook");
  const el = $("#fbBody").empty();
  if(!res.ok || res.jobs.length===0){ el.html('<tr><td colspan="5" class="text-center text-muted">Kosong</td></tr>'); return; }
  res.jobs.filter(j=>j.platform==="facebook").forEach(j=>{
    const badge = j.status==="running"?"success":j.status==="scheduled"?"warning":j.status==="stopped"?"secondary":"danger";
    el.append(`<tr>
      <td>${j.id}</td>
      <td>${j.input}</td>
      <td><span class="badge bg-${badge}">${j.status}</span></td>
      <td>${j.startedAt||""} ${j.stoppedAt?("<br/>"+j.stoppedAt):""}</td>
      <td>
        ${j.status==="running" ? `<button class="btn btn-danger btn-sm" onclick="stopJobFB('${j.id}')">Stop</button>` :
          j.status==="scheduled" ? `<button class="btn btn-secondary btn-sm" onclick="cancelJobFB('${j.id}')">Cancel</button>` :
          `<button class="btn btn-success btn-sm" onclick="startJobFB('${j.id}')">Start</button>`}
      </td>
    </tr>`);
  });
})();
async function startJobFB(id){ const r=await apiPOST(`/api/facebook/${id}/start`,{}); Swal.fire(r.ok?"Dimulai":"Gagal", r.message||"", r.ok?"success":"error").then(()=>location.reload());}
async function stopJobFB(id){ const r=await apiPOST(`/api/facebook/${id}/stop`,{}); Swal.fire(r.ok?"Dihentikan":"Gagal", r.message||"", r.ok?"success":"error").then(()=>location.reload());}
async function cancelJobFB(id){ const r=await apiDELETE(`/api/facebook/${id}`); Swal.fire(r.ok?"Dibatalkan":"Gagal", r.message||"", r.ok?"success":"error").then(()=>location.reload());}
</script>

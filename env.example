PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_super_long_random_secret

# FFmpeg defaults
FFMPEG_BIN=ffmpeg
DEFAULT_FPS=30
DEFAULT_WIDTH=1280
DEFAULT_HEIGHT=720
DEFAULT_VIDEO_BITRATE=3000k
DEFAULT_AUDIO_BITRATE=128k
DEFAULT_KEYINT=60

# CORS (coma separated)
CORS_ORIGINS=http://localhost:3000

# Optional seed admin (on first boot)
ADMIN_SEED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
